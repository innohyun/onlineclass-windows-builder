{
  "name": "local-sensitive-store-desktop",
  "private": true,
  "version": "0.2.96",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:frontend:raw": "tsc --noEmit && vite build",
    "prepare:student-record-mcp-sidecar": "node scripts/prepare-student-record-mcp-sidecar.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:desktop": "npm run tauri dev",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1 && npm run release:collect:desktop",
    "build:installer:mac": "node scripts/build-installer-mac.mjs && npm run release:collect:desktop",
    "release:collect:desktop": "node ../tools/desktop-release/collect-installers.mjs --only=local-sensitive-store-desktop"
  },
  "dependencies": {
    "@classaimate-v3/domain": "file:../packages/domain",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-details": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "pdfjs-dist": "6.2.108",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "6.0.3"
  }
}
